#!/usr/bin/env python3
"""
pinentry-keepassxc: A native Qt (PyQt6) Pinentry wrapper for GnuPG and Secret Service.
Provides automatic silent passphrase retrieval via Secret Service (libsecret),
and a native Qt GUI dialog with a "Save in password manager" checkbox.
"""
import sys
import re
import subprocess
import urllib.parse

# Ensure line-buffered stdout for Assuan IPC
sys.stdout.reconfigure(line_buffering=True)

from PyQt6.QtWidgets import (
    QApplication, QDialog, QVBoxLayout, QHBoxLayout, QLabel, 
    QLineEdit, QCheckBox, QPushButton
)

def lookup_secret(key_id):
    if not key_id:
        return None
    try:
        res = subprocess.run(
            ["secret-tool", "lookup", "gpg-key", key_id],
            capture_output=True, text=True, timeout=2
        )
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    return None

def store_secret(key_id, label, passphrase):
    if not key_id or not passphrase:
        return
    try:
        subprocess.run(
            ["secret-tool", "store", "--label", label, "gpg-key", key_id],
            input=passphrase, text=True, timeout=5
        )
    except Exception:
        pass

class PinentryDialog(QDialog):
    def __init__(self, desc, key_id):
        super().__init__()
        self.passphrase = None
        self.save_secret = False
        self.key_id = key_id
        self.init_ui(desc)

    def init_ui(self, desc):
        self.setWindowTitle("Unlock GPG Key")
        self.setMinimumWidth(480)

        layout = QVBoxLayout()
        layout.setSpacing(12)

        # Description (Percent-decoded for clean display and multi-line formatting)
        desc_text = desc or "Please enter your GPG key passphrase:"
        desc_label = QLabel(desc_text)
        desc_label.setWordWrap(True)
        layout.addWidget(desc_label)

        # Password Input Layout
        pwd_layout = QHBoxLayout()
        self.pwd_input = QLineEdit()
        self.pwd_input.setEchoMode(QLineEdit.EchoMode.Password)
        self.pwd_input.setPlaceholderText("Passphrase")
        pwd_layout.addWidget(self.pwd_input)

        # Show/Hide Password Checkbox
        self.show_pwd_cb = QCheckBox("Show")
        self.show_pwd_cb.toggled.connect(self.toggle_show_pwd)
        pwd_layout.addWidget(self.show_pwd_cb)

        layout.addLayout(pwd_layout)

        # Save in Password Manager Checkbox (Generic phrasing for any libsecret backend)
        self.save_cb = QCheckBox("Save in password manager")
        self.save_cb.setChecked(True)
        layout.addWidget(self.save_cb)

        # Buttons
        btn_layout = QHBoxLayout()
        btn_layout.addStretch()

        self.ok_btn = QPushButton("OK")
        self.ok_btn.setDefault(True)
        self.ok_btn.clicked.connect(self.on_ok)
        btn_layout.addWidget(self.ok_btn)

        self.cancel_btn = QPushButton("Cancel")
        self.cancel_btn.clicked.connect(self.reject)
        btn_layout.addWidget(self.cancel_btn)

        layout.addLayout(btn_layout)
        self.setLayout(layout)

        self.pwd_input.setFocus()

    def toggle_show_pwd(self, checked):
        if checked:
            self.pwd_input.setEchoMode(QLineEdit.EchoMode.Normal)
        else:
            self.pwd_input.setEchoMode(QLineEdit.EchoMode.Password)

    def on_ok(self):
        self.passphrase = self.pwd_input.text()
        self.save_secret = self.save_cb.isChecked()
        self.accept()

def main():
    desc = ""
    main_key_id = ""
    sub_key_id = ""
    keygrip = ""

    # Assuan protocol initial greeting
    sys.stdout.write("OK Pleased to meet you\n")

    while True:
        line = sys.stdin.readline()
        if not line:
            break
        line_str = line.strip()

        if line_str.startswith("SETDESC"):
            raw_desc = line_str[7:].strip()
            # Decode Assuan percent-encoding (%0A -> \n, %22 -> ", etc.)
            desc = urllib.parse.unquote(raw_desc)
            
            m = re.search(r'main[_\s]+key[_\s]+ID[_\s]+([A-Fa-f0-9]+)', desc, re.IGNORECASE)
            if m:
                main_key_id = m.group(1)
            m_sub = re.search(r'ID[_\s]+([A-Fa-f0-9]{8,40})', desc, re.IGNORECASE)
            if m_sub:
                sub_key_id = m_sub.group(1)
            sys.stdout.write("OK\n")

        elif line_str.startswith("SETKEYINFO"):
            parts = line_str.split()
            if len(parts) > 1:
                keygrip = parts[1]
            sys.stdout.write("OK\n")

        elif line_str.startswith("GETPIN"):
            target_key = main_key_id or sub_key_id or keygrip

            # 1. Try lookup in secret storage silently first
            cached_pw = (
                lookup_secret(main_key_id) or 
                lookup_secret(sub_key_id) or 
                lookup_secret(keygrip) or 
                lookup_secret("GPG Key")
            )
            if cached_pw:
                sys.stdout.write(f"D {cached_pw}\nOK\n")
                return

            # 2. Launch native PyQt6 GUI dialog
            app = QApplication(sys.argv)
            dialog = PinentryDialog(desc, target_key)
            if dialog.exec() == QDialog.DialogCode.Accepted:
                pw = dialog.passphrase
                if dialog.save_secret and target_key:
                    lbl = f"GPG Key ({target_key})"
                    store_secret(target_key, lbl, pw)
                    if main_key_id and main_key_id != target_key:
                        store_secret(main_key_id, lbl, pw)
                    if sub_key_id and sub_key_id != target_key:
                        store_secret(sub_key_id, lbl, pw)

                sys.stdout.write(f"D {pw}\nOK\n")
                return
            else:
                sys.stdout.write("ERR 83886179 Operation cancelled <Pinentry>\n")
                sys.exit(1)
        elif line_str.startswith("BYE"):
            sys.stdout.write("OK\n")
            sys.exit(0)
        else:
            sys.stdout.write("OK\n")

if __name__ == "__main__":
    main()
