#!/usr/bin/env python3
"""
pinentry-libsecret: A modern, toolkit-configurable Pinentry wrapper for GnuPG and Freedesktop Secret Service.
Provides automatic silent passphrase retrieval via Secret Service (libsecret),
and multi-toolkit GUI prompts (PyQt, kdialog, zenity) with "Save in password manager" support.
"""
import sys
import os
import re
import shutil
import subprocess
import urllib.parse

# Ensure line-buffered stdout for Assuan IPC
sys.stdout.reconfigure(line_buffering=True)

def lookup_secret(key_id):
    if not key_id:
        return None
    try:
        res = subprocess.run(
            ["secret-tool", "lookup", "gpg-key", key_id],
            capture_output=True, text=True, timeout=2
        )
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    return None

def store_secret(key_id, label, passphrase):
    if not key_id or not passphrase:
        return
    try:
        subprocess.run(
            ["secret-tool", "store", "--label", label, "gpg-key", key_id],
            input=passphrase, text=True, timeout=5
        )
    except Exception:
        pass

def find_system_pinentry(custom_path=None):
    if custom_path and shutil.which(custom_path):
        return custom_path
    
    env_path = os.environ.get("PINENTRY_LIBSECRET_FALLBACK")
    if env_path and shutil.which(env_path):
        return env_path

    # Candidate list for system pinentry
    candidates = [
        "pinentry-qt",
        "pinentry-gnome3",
        "pinentry-gtk-2",
        "pinentry-gtk",
        "pinentry-kwallet",
        "pinentry-curses",
        "pinentry"
    ]
    for c in candidates:
        path = shutil.which(c)
        if path and not path.endswith("pinentry-libsecret"):
            return path
    return None

# --- TOOLKIT PROMPT IMPLEMENTATIONS ---

def prompt_pyqt(desc, target_key):
    from PyQt6.QtWidgets import (
        QApplication, QDialog, QVBoxLayout, QHBoxLayout, QLabel, 
        QLineEdit, QCheckBox, QPushButton
    )

    class PinentryDialog(QDialog):
        def __init__(self, desc, key_id):
            super().__init__()
            self.passphrase = None
            self.save_secret = False
            self.key_id = key_id
            self.init_ui(desc)

        def init_ui(self, desc):
            self.setWindowTitle("Unlock GPG Key")
            self.setMinimumWidth(480)

            layout = QVBoxLayout()
            layout.setSpacing(12)

            desc_label = QLabel(desc or "Please enter your GPG key passphrase:")
            desc_label.setWordWrap(True)
            layout.addWidget(desc_label)

            pwd_layout = QHBoxLayout()
            self.pwd_input = QLineEdit()
            self.pwd_input.setEchoMode(QLineEdit.EchoMode.Password)
            self.pwd_input.setPlaceholderText("Passphrase")
            pwd_layout.addWidget(self.pwd_input)

            self.show_pwd_cb = QCheckBox("Show")
            self.show_pwd_cb.toggled.connect(self.toggle_show_pwd)
            pwd_layout.addWidget(self.show_pwd_cb)
            layout.addLayout(pwd_layout)

            self.save_cb = QCheckBox("Save in password manager")
            self.save_cb.setChecked(True)
            layout.addWidget(self.save_cb)

            btn_layout = QHBoxLayout()
            btn_layout.addStretch()

            self.ok_btn = QPushButton("OK")
            self.ok_btn.setDefault(True)
            self.ok_btn.clicked.connect(self.on_ok)
            btn_layout.addWidget(self.ok_btn)

            self.cancel_btn = QPushButton("Cancel")
            self.cancel_btn.clicked.connect(self.reject)
            btn_layout.addWidget(self.cancel_btn)

            layout.addLayout(btn_layout)
            self.setLayout(layout)
            self.pwd_input.setFocus()

        def toggle_show_pwd(self, checked):
            self.pwd_input.setEchoMode(
                QLineEdit.EchoMode.Normal if checked else QLineEdit.EchoMode.Password
            )

        def on_ok(self):
            self.passphrase = self.pwd_input.text()
            self.save_secret = self.save_cb.isChecked()
            self.accept()

    app = QApplication.instance() or QApplication(sys.argv)
    dialog = PinentryDialog(desc, target_key)
    if dialog.exec() == QDialog.DialogCode.Accepted:
        return dialog.passphrase, dialog.save_secret
    return None, False

def prompt_kdialog(desc, target_key):
    if not shutil.which("kdialog"):
        raise RuntimeError("kdialog not installed")
    
    # Prompt 1: Password input
    res_pw = subprocess.run(
        ["kdialog", "--title", "Unlock GPG Key", "--password", desc or "Please enter GPG passphrase:"],
        capture_output=True, text=True
    )
    if res_pw.returncode != 0:
        return None, False
    
    pw = res_pw.stdout.rstrip("\r\n")

    # Prompt 2: Save in password manager?
    res_save = subprocess.run(
        ["kdialog", "--title", "Unlock GPG Key", "--yesno", "Save passphrase in password manager?"],
        capture_output=True, text=True
    )
    save_secret = (res_save.returncode == 0)
    return pw, save_secret

def prompt_zenity(desc, target_key):
    if not shutil.which("zenity"):
        raise RuntimeError("zenity not installed")
    
    # Prompt 1: Password input
    res_pw = subprocess.run(
        ["zenity", "--password", "--title=Unlock GPG Key", f"--text={desc or 'Please enter GPG passphrase:'}"],
        capture_output=True, text=True
    )
    if res_pw.returncode != 0:
        return None, False

    pw = res_pw.stdout.rstrip("\r\n")

    # Prompt 2: Save in password manager?
    res_save = subprocess.run(
        ["zenity", "--question", "--title=Unlock GPG Key", "--text=Save passphrase in password manager?"],
        capture_output=True, text=True
    )
    save_secret = (res_save.returncode == 0)
    return pw, save_secret

def main():
    # Parse CLI flags & Env vars
    preferred_toolkit = os.environ.get("PINENTRY_LIBSECRET_TOOLKIT", "auto").lower()
    custom_fallback = None

    for arg in sys.argv[1:]:
        if arg.startswith("--toolkit="):
            preferred_toolkit = arg.split("=", 1)[1].lower()
        elif arg.startswith("--fallback-pinentry="):
            custom_fallback = arg.split("=", 1)[1]

    desc = ""
    main_key_id = ""
    sub_key_id = ""
    keygrip = ""
    raw_commands = ""

    # Assuan protocol initial greeting
    sys.stdout.write("OK Pleased to meet you\n")

    while True:
        line = sys.stdin.readline()
        if not line:
            break
        raw_commands += line
        line_str = line.strip()

        if line_str.startswith("SETDESC"):
            raw_desc = line_str[7:].strip()
            desc = urllib.parse.unquote(raw_desc)
            
            m = re.search(r'main[_\s]+key[_\s]+ID[_\s]+([A-Fa-f0-9]+)', desc, re.IGNORECASE)
            if m:
                main_key_id = m.group(1)
            m_sub = re.search(r'ID[_\s]+([A-Fa-f0-9]{8,40})', desc, re.IGNORECASE)
            if m_sub:
                sub_key_id = m_sub.group(1)
            sys.stdout.write("OK\n")

        elif line_str.startswith("SETKEYINFO"):
            parts = line_str.split()
            if len(parts) > 1:
                keygrip = parts[1]
            sys.stdout.write("OK\n")

        elif line_str.startswith("GETPIN"):
            primary_key = main_key_id or sub_key_id or keygrip

            # 1. Try silent Secret Service lookup first
            cached_pw = (
                lookup_secret(main_key_id) or 
                lookup_secret(sub_key_id) or 
                lookup_secret(keygrip) or 
                lookup_secret("GPG Key")
            )
            if cached_pw:
                sys.stdout.write(f"D {cached_pw}\nOK\n")
                return

            # 2. Try configured/preferred GUI toolkit
            pw = None
            save_secret = False
            toolkits_to_try = []

            if preferred_toolkit == "pyqt":
                toolkits_to_try = [prompt_pyqt]
            elif preferred_toolkit == "kdialog":
                toolkits_to_try = [prompt_kdialog]
            elif preferred_toolkit == "zenity":
                toolkits_to_try = [prompt_zenity]
            else: # "auto"
                toolkits_to_try = [prompt_pyqt, prompt_kdialog, prompt_zenity]

            for tk_func in toolkits_to_try:
                try:
                    pw, save_secret = tk_func(desc, primary_key)
                    if pw is not None:
                        break
                except Exception:
                    continue

            # 3. If GUI prompt succeeded, return password & optionally save
            if pw is not None:
                if save_secret and primary_key:
                    lbl = f"GPG Key ({primary_key})"
                    store_secret(primary_key, lbl, pw)
                sys.stdout.write(f"D {pw}\nOK\n")
                return

            # 4. Fallback to system pinentry binary if GUI prompts failed/unavailable
            sys_pinentry = find_system_pinentry(custom_fallback)
            if sys_pinentry:
                p = subprocess.Popen([sys_pinentry] + sys.argv[1:], stdin=subprocess.PIPE)
                p.communicate(input=raw_commands.encode())
                sys.exit(p.returncode)

            sys.stdout.write("ERR 83886179 Operation cancelled <Pinentry>\n")
            sys.exit(1)

        elif line_str.startswith("BYE"):
            sys.stdout.write("OK\n")
            sys.exit(0)
        else:
            sys.stdout.write("OK\n")

if __name__ == "__main__":
    main()
